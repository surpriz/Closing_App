# Copy to .env.local (`vercel env pull .env.local` fills most of it once the
# Vercel integrations are connected)

# [[APP]]
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [[DATABASE - NEON]]
# Pooled connection (host contains "-pooler"), used by the app at runtime
DATABASE_URL=
# Direct connection, used by Prisma CLI for migrations
DATABASE_URL_UNPOOLED=

# [[AUTH - BETTER AUTH]]
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Sender for magic link emails (domain verified in Resend)
AUTH_EMAIL_FROM="Closing <auth@mail.example.com>"
# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [[STORAGE - VERCEL BLOB]]
BLOB_READ_WRITE_TOKEN=

# [[EMAIL - RESEND]]
RESEND_API_KEY=
FOLLOWUP_EMAIL_FROM="Sales <sales@mail.example.com>"
FOLLOWUP_EMAIL_REPLY_TO=

# [[AI]]
# openai | anthropic
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides, e.g. gpt-4o / claude-sonnet-5
AI_MODEL_FOLLOWUP=
AI_MODEL_CHAT=
# Cheap model for page tagging, e.g. gpt-4o-mini / claude-haiku-4-5-20251001
AI_MODEL_CLASSIFY=

# [[WHATSAPP - TWILIO]]
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender in Twilio format, e.g. whatsapp:+33612345678
TWILIO_WHATSAPP_FROM=
# Approved content template, required outside the 24h customer service window
TWILIO_WHATSAPP_TEMPLATE_SID_FOLLOWUP=

# [[BACKGROUND JOBS - TRIGGER.DEV]]
TRIGGER_PROJECT_ID=
TRIGGER_SECRET_KEY=

# [[SECURITY]]
# 32+ chars, encrypts Slack webhook URLs and webhook secrets at rest
ENCRYPTION_KEY=
# 16+ chars, salts viewer IP hashes (raw IPs are never stored)
IP_HASH_SALT=

# [[FOLLOW-UPS]]
# Used when the prospect timezone could not be detected
DEFAULT_TIMEZONE=Europe/Paris

# [[BILLING - STRIPE]]
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
