generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URLs live in prisma.config.ts (CLI) and src/lib/db.ts (runtime)
datasource db {
  provider = "postgresql"
}

// =============================================================================
// Auth (Better Auth core + organization plugin)
// =============================================================================

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Better Auth admin plugin. "admin" is the platform admin, not a workspace role.
  role       String?
  banned     Boolean   @default(false)
  banReason  String?
  banExpires DateTime?

  /// Seller UI language ("en" | "fr"): app, emails, alerts, AI output.
  locale String @default("en")

  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[]

  documents               Document[]
  linksCreated            Link[]
  extensionTokens         ExtensionToken[]
  sellerAlerts            SellerAlert[]
  notificationPreferences NotificationPreference[]
  onboardingEmails        OnboardingEmail[]
  helpMessages            HelpMessage[]
  helpFeedback            HelpFeedback[]
  mailboxes               Mailbox[]

  @@map("users")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  // Set when the platform admin signed in as this user
  impersonatedBy       String?

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// A workspace = one customer company of the SaaS
model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime
  metadata  String?

  members     Member[]
  invitations Invitation[]

  settings         WorkspaceSettings?
  documents        Document[]
  links            Link[]
  stripeCustomerId String?            @unique
  // What is paid for or granted: free | solo | team | enterprise. The plan in force is computed (lib/billing/plans.ts)
  plan             String             @default("free")
  extensionTokens  ExtensionToken[]

  // Mirror of the Stripe subscription; "comped" when granted by the platform admin. Null: never subscribed
  planStatus           String?
  stripeSubscriptionId String?   @unique
  billingInterval      String? // month | year
  seats                Int?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  paymentFailedAt      DateTime?
  // Reverse trial: Team until then, no card
  trialEndsAt          DateTime?
  // Created during the beta: Team until BETA_GRACE_UNTIL
  betaGrace            Boolean   @default(false)
  stripeEvents         StripeEvent[]

  // Suspended by the platform admin: members locked out, cron and public links stopped
  suspendedAt     DateTime?
  suspendedReason String?

  notificationPreferences NotificationPreference[]
  onboardingEmails        OnboardingEmail[]
  helpMessages            HelpMessage[]
  helpFeedback            HelpFeedback[]

  targetProfiles      TargetProfile[]
  prospectingRuns     ProspectingRun[]
  prospectSuggestions ProspectSuggestion[]
  prospectingCredits  ProspectingCreditEntry[]

  mailboxes       Mailbox[]
  campaigns       Campaign[]
  suppressions    Suppression[]
  mailboxQuantity Int? // Connected mailboxes billed on the Stripe add-on item

  @@map("organizations")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("members")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

// Lets the browser extension call /api/ext/* on behalf of one seller. Only the hash is stored.
model ExtensionToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  hint       String // last characters, shown in settings
  label      String? // browser and OS at connection time
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("extension_tokens")
}

// Pairs the Outlook add-in, which never sees the browser session: the add-in polls
// with a secret it keeps, the seller types the short code in the app. Lives 10 minutes.
model ExtensionPairing {
  id              String   @id @default(cuid())
  pollHash        String   @unique
  userCode        String   @unique
  // The new token, encrypted, until the add-in picks it up (then the row is deleted)
  tokenCiphertext String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@map("extension_pairings")
}

// =============================================================================
// Platform admin
// =============================================================================

// Banned emails: no account can be created with them, even after deletion
model BlockedEmail {
  email       String   @id
  reason      String?
  createdById String
  createdAt   DateTime @default(now())

  @@map("blocked_emails")
}

// Emails that may sign up while sign-ups are invite-only
model AllowedEmail {
  email     String   @id
  createdAt DateTime @default(now())

  @@map("allowed_emails")
}

// One row, id "singleton"
model PlatformSettings {
  id         String   @id @default("singleton")
  signupMode String   @default("open") // open | invite_only
  updatedAt  DateTime @updatedAt

  @@map("platform_settings")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String // user | organization | settings
  targetId   String?
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// Sensitive actions inside a workspace (team, exports, erasures, deletions, extension access).
// No relation to the workspace on purpose: the deletion of a workspace is itself logged.
// Never holds a prospect's email; purged after 12 months like tracking data
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// Better Auth rate limiting (sign-in, magic link): serverless has no shared memory
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limits")
}

// Our own limits on public endpoints (email gate, smart link, tracking, upload, pairing).
// Fixed window per key; the key holds a hashed IP, never the raw address
model RequestLimit {
  key         String   @id
  count       Int
  windowStart DateTime

  @@index([windowStart])
  @@map("request_limits")
}

// =============================================================================
// Enums
// =============================================================================

enum DocumentStatus {
  UPLOADED
  PROCESSING // text extraction + page tagging
  READY
  FAILED
}

enum DocumentKind {
  FILE // PDF stored in Blob, rendered with pdf.js
  URL // external web page (Notion, Loom, Figma...) shown in an iframe
  VIDEO // pitch recorded by the seller in Clozer, stored in Blob, tracked as 10 slices of 10%
}

enum PageTag {
  PRICING
  TERMS
  TIMELINE
  SCOPE
  TEAM
  CASE_STUDY
  OTHER
}

enum PageTagSource {
  AUTO
  MANUAL
}

enum DealStatus {
  OPEN
  VALIDATED // prospect clicked "Validate & sign"
  CHANGE_REQUESTED
  WON
  LOST
}

enum FollowupChannel {
  EMAIL
  WHATSAPP
}

enum FollowupTrigger {
  HOT_PRICING // long read on the pricing page without validation
  ANTI_GHOSTING // no view after N days
  MANUAL // queued by the seller
  AI_DECISION // decided by the deal analysis
  EXPIRY_REMINDER // the link expires soon (quotes and proposals)
  WARM_READ // a cold email reader read for a while without answering
  INTEREST_RETURNED // the seller reopened a dead link the prospect had come back to
}

enum FollowupStatus {
  PENDING // created, message not generated yet
  DRAFT // message ready, waiting for the seller to approve it (copilot mode)
  GENERATED // message approved (or autopilot), waiting for its send slot
  SCHEDULED // delayed run registered in Trigger.dev
  SENT
  DELIVERED // confirmed by provider webhook
  FAILED
  CANCELLED // deal closed, new activity or cancelled by seller
  SKIPPED // guard failed at send time (opt-out, no phone, ...)
}

enum FollowupSentVia {
  PLATFORM // sent by Clozer (SES, Twilio)
  MANUAL // the seller sent it from their own mailbox
  MAILBOX // sent from the seller's connected mailbox
}

enum Autonomy {
  COPILOT // every follow-up waits for the seller's approval
  AUTOPILOT // confident follow-ups go out on their own
}

enum SellerActivityType {
  CALL
  EMAIL_REPLY_RECEIVED
  MEETING
  NOTE
  MANUAL_SEND
}

// Who logged a seller activity: the seller, or Clozer noticing a reply on its own
enum ActivitySource {
  MANUAL // typed by the seller
  INBOUND // a reply to an email Clozer sent, caught by the reply relay
  EXTENSION // a reply seen by the extension in the seller's Gmail or Outlook thread
  MAILBOX // a reply seen by the mailbox sync of a campaign
  SEQUENCER // a reply the seller's cold email tool reported through its webhook (Smart Link)
}

// Why a deal was lost, picked by the seller in one click
enum DealCloseReason {
  PRICE
  TIMING
  COMPETITOR
  NO_DECISION
  NO_NEED
  OTHER
}

enum MeetingOutcome {
  HELD
  NO_SHOW
  CANCELLED
}

enum InsightTrigger {
  SESSION_ENDED // a prospect closed the document
  PROSPECT_ACTION // validation or change request
  SELLER_UPDATE // deal context or logged exchange changed
  TIME_THRESHOLD // silence crossed a step (1, 3, 7… days), caught by the engine
  MANUAL // "Réanalyser"
}

enum EngagementTier {
  HOT
  WARM
  COLD
}

enum SellerAlertType {
  MULTI_VIEWER
  REOPENED_AFTER_INACTIVITY
  DRAFT_READY // a follow-up waits for the seller's approval (at most one per hour per workspace)
  PROSPECT_VALIDATED // the prospect clicked "Valider & signer"
  CHANGE_REQUESTED // the prospect asked for an adjustment
  CALL_MOMENT // the prospect is reading right now and it is worth a call
  COMMITTEE_LIVE // several people of the prospect side read at the same time
  NEW_READER // someone other than the recipient opened the proposal
  DECISION_MAKER_DETECTED // a finance or executive contact reads the proposal
  PROSPECT_QUESTION // the prospect asked the assistant something it could not answer
  LINK_EXTENSION_REQUESTED // the link expired and the prospect asked for more time
  LINK_EXPIRING // the link expires within 24h
  VOICE_COMMENT // the prospect left a voice comment on a page
  MEETING_BOOKED // the prospect booked a meeting in the seller's calendar from the viewer
  QUOTE_REQUESTED // the prospect asked for a quote under a video pitch
  DOCUMENT_FORWARDED // a reader passed the proposal on with "Transférer"
  PROSPECT_REPLIED // the prospect answered by email: automatic follow-ups stopped
  EMAIL_BOUNCED // an email Clozer sent to the prospect bounced: the address is wrong
  DEAD_LINK_OPENED // the prospect came back to an archived or expired link without asking anything
  RELINK_REQUESTED // the link was archived and the prospect asked for the document again
  SMART_LINK_PROBLEM // a cold email reader came without a usable address: a personal link, or a tool variable left as is
}

// Role of a prospect contact in the buying committee, set by the seller.
// Null on Prospect.role means "guess it from the email" (committee/roles.ts).
enum ProspectRole {
  DECISION_MAKER
  FINANCE
  TECHNICAL
  CHAMPION
  INFLUENCER
  OTHER
}

enum ProspectOrigin {
  SELLER // added by the seller (dashboard or extension): the original recipient
  EMAIL_GATE // typed an email to open the link, the proposal was passed on
  PROSPECTING // suggested by Clozer prospecting: an unsubscribe also opts out of prospecting for everyone
  COLD_EMAIL // came from a cold email Smart Link: the address was in the URL, unverified
  FORWARDED // another reader sent them the link with "Transférer": the address was typed by that reader
  CAMPAIGN // enrolled by the seller in a native campaign: the address came from their own list
}

enum SellerAlertChannel {
  EMAIL
  SLACK
  WEBHOOK
  EXTENSION // stored only, the browser extension polls for it
}

// How hard an alert may interrupt the seller (notify/policy.ts)
enum AlertPriority {
  ACTION // the prospect did something: validated, asked for a change, booked a meeting
  CALL // reading right now, a call would land well
  INFO // can wait for the morning digest
}

// What a reader did around the content that page time does not show (tracking/view-signals.ts)
enum ViewSignalType {
  EXTERNAL_OPEN // opened the web page in a new tab
  EXTERNAL_RETURN // came back to the tab; valueMs = time away, an estimate of time on the site
  DOWNLOAD // downloaded the PDF
  EXIT_PROMPT_SHOWN // about to leave: the assistant offered to answer a question
  EXIT_PROMPT_OPENED // and the reader took it
  TRANSLATED // read the document translated; detail = the language
  COPY_TEXT // copied text from the document; detail = the page, valueMs = characters copied
  PRINT // printed the document
}

enum ProspectActionType {
  VALIDATE_SIGN
  REQUEST_CHANGE
  REQUEST_EXTENSION // the link expired, the prospect asked for more time
  MEETING_CLICK // opened the seller's booking page (once per view)
  MEETING_BOOKED // the booking widget reported a confirmed meeting
  REQUEST_QUOTE // "Demander un devis" under a video pitch
  REQUEST_RELINK // the link was archived, the prospect asked for the document again
}

enum ChatRole {
  USER
  ASSISTANT
}

enum HelpFeedbackKind {
  SUGGESTION
  BUG
  QUESTION // the help assistant could not answer
  OTHER
}

// =============================================================================
// Documents & links
// =============================================================================

model WorkspaceSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  defaultChannels           FollowupChannel[] @default([EMAIL])
  hotPricingThresholdSec    Int               @default(90)
  inactivityDays            Int[]             @default([3, 7, 14]) // anti-ghosting steps, days since link was sent; the last one closes the loop
  businessHourStart         Int               @default(9) // prospect local hour, inclusive
  businessHourEnd           Int               @default(18) // prospect local hour, exclusive
  businessDays              Int[]             @default([1, 2, 3, 4, 5]) // ISO weekday, 1 = Monday
  multiViewerThreshold      Int               @default(2) // alert when live unique viewers > threshold
  committeeThreshold        Int               @default(3) // committee alert when live distinct people >= threshold
  reopenAfterInactivityDays Int               @default(3)
  chatEnabledByDefault      Boolean           @default(true)
  // New links start from these; the document type adjusts them (see smart-defaults.ts)
  requireEmailByDefault     Boolean           @default(true)
  voiceCommentsByDefault    Boolean           @default(true)
  followupsByDefault        Boolean           @default(true)
  quoteExpiryDays           Int?              @default(15) // quotes and proposals lock after N days; null = never

  alertChannels      SellerAlertChannel[] @default([EMAIL])
  alertEmail         String?
  slackWebhookUrl    String? // encrypted at rest
  outboundWebhookUrl String?
  webhookSecret      String? // encrypted at rest, signs outbound webhooks

  aiTone          String? // free text guidance for generated messages
  senderName      String?
  senderSignature String?

  autonomy                  Autonomy  @default(COPILOT)
  autopilotMinConfidence    Int       @default(80) // 0-100
  maxFollowupsPer30Days     Int       @default(3) // per prospect
  minDaysBetweenFollowups   Int       @default(3)
  minDelayAfterReadingHours Int       @default(3) // a follow-up right after a read gives the tracking away
  lastDigestAt              DateTime? // unused: the morning digest is per seller (notification_preferences)

  // What the seller sells, fed to the AI
  offerDescription   String?
  targetCustomer     String?
  valueProps         String?
  commonObjections   String?
  avgSalesCycleDays  Int?
  // What the prospect assistant should know on every document (FAQ, terms, support…). Prospects can be told all of it.
  assistantKnowledge String?
  // Name of the document the offer was guessed from, until the seller saves the settings
  offerInferredFrom  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workspace_settings")
}

model Document {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId        String?
  owner          User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  kind            DocumentKind   @default(FILE)
  name            String
  blobUrl         String?
  blobPathname    String?
  contentType     String         @default("application/pdf")
  sizeBytes       Int            @default(0)
  externalUrl     String? // URL documents: the page as pasted by the seller
  embedUrl        String? // URL documents: what the viewer frames, null when the site refuses framing
  readerHtml      String? // URL documents that refuse framing: their article, cleaned, shown in Clozer
  numPages        Int?
  status          DocumentStatus @default(UPLOADED)
  // VIDEO documents: still shown before playing, mic-only track that gets transcribed, length measured by the recorder
  posterPathname  String?
  audioPathname   String?
  durationMs      Int?
  processingError String?

  // AI reading of the pages (summaries, tags, key facts). Retried by the engine until it works, 3 tries max.
  aiProcessedAt     DateTime?
  aiAttempts        Int           @default(0)
  // URL documents have no text: the seller says what the page is about
  sellerDescription String?
  // Written for the prospect assistant: details the document leaves out. Prospects can be told all of it.
  assistantNotes    String?
  // What kind of document this is (QUOTE, RESUME…, see documents/doc-types.ts) and what it is for, guessed by the AI
  docType           String?
  // MANUAL once the seller corrected the type: a new AI reading keeps it
  docTypeSource     PageTagSource @default(AUTO)
  docPurpose        String?
  // Short human title written by the AI ("Devis rénovation cuisine"), shown to prospects instead of the file name
  displayTitle      String?
  // sha256 of the PDF bytes, so the same file sent twice is stored and read once
  contentSha256     String?
  // ISO 639-1 code of the content, guessed by the AI reading. Null: unknown, every language is offered
  language          String?

  pages            DocumentPage[]
  links            Link[]
  capsules         PageCapsule[]
  translations     DocumentTranslation[]
  fileTranslations DocumentFileTranslation[]
  campaigns        Campaign[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, contentSha256])
  @@map("documents")
}

model DocumentPage {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  pageNumber Int // 1-based
  text       String? // extracted text, feeds page tagging and the prospect chat
  summary    String? // one or two sentences, written by the AI at upload
  keyFacts   String[]      @default([]) // amounts, durations, options stated on the page
  tags       PageTag[]
  tagSource  PageTagSource @default(AUTO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentId, pageNumber])
  @@map("document_pages")
}

// A page (or the web article) translated for a reader, kept so each language is paid for once per document
model DocumentTranslation {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  locale  String // SUPPORTED_LOCALES
  part    Int // PDF: the page number. URL: 1, the whole article as HTML
  content String
  model   String?

  createdAt DateTime @default(now())

  @@unique([documentId, locale, part])
  @@map("document_translations")
}

enum FileTranslationStatus {
  PENDING // sent to DeepL, or being sent
  DONE // the translated PDF is in our blob store
  FAILED
}

// A PDF translated by DeepL with its layout, one per language. Kept on our side: DeepL lets each result be downloaded once
model DocumentFileTranslation {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  locale           String // SUPPORTED_LOCALES
  status           FileTranslationStatus @default(PENDING)
  // Given by DeepL at upload, needed to ask for the status and the result. The key is not kept by DeepL
  deeplDocumentId  String?
  deeplDocumentKey String?
  blobPathname     String?
  billedCharacters Int?
  error            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentId, locale])
  @@map("document_file_translations")
}

// One link = one proposal sent to one prospect company. Public URL: /v/[slug]
model Link {
  id             String       @id @default(cuid())
  slug           String       @unique // random, unguessable
  documentId     String
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  name          String?
  requireEmail  Boolean   @default(true)
  allowDownload Boolean   @default(false)
  expiresAt     DateTime? // after it the viewer locks and the prospect can ask for more time

  dealStatus           DealStatus @default(OPEN)
  chatEnabled          Boolean    @default(true)
  ctaEnabled           Boolean    @default(true)
  // the prospect can record a voice comment on a page (PDF only)
  voiceCommentsEnabled Boolean    @default(true)
  // "Prendre rendez-vous", independent of ctaEnabled: a CV or a deck calls for a meeting, not a signature
  bookingEnabled       Boolean    @default(true)
  // the reader can pick a language and read the document translated by the AI (PDF and web reader view)
  translationEnabled   Boolean    @default(true)
  // "Transférer" in the viewer: a reader passes the document on (personal links only)
  forwardEnabled       Boolean    @default(true)
  // Booking page shown to the prospect; null = the link creator's (NotificationPreference.bookingUrl)
  bookingUrl           String?
  // The prospect booked a meeting from the viewer: automatic follow-ups stop for good
  meetingBookedAt      DateTime?
  meetingAt            DateTime? // start of the latest booked meeting, when the widget gave it (Cal.com)
  // The prospect asked for a quote under a video pitch: the seller answers, automatic follow-ups stop for good
  quoteRequestedAt     DateTime?
  // The prospect answered by email (reply relay or extension): the conversation is the seller's, automatic follow-ups stop
  repliedAt            DateTime?
  // Did the booked meeting take place? Asked to the seller once meetingAt has passed
  meetingOutcome       MeetingOutcome?
  meetingOutcomeAt     DateTime?
  // Someone reached the email gate without typing an address: clicked, but did not read
  gateSeenAt           DateTime?
  gateVisits           Int               @default(0)

  followupsEnabled       Boolean           @default(true)
  channels               FollowupChannel[] // empty = workspace defaults
  // null / empty = workspace defaults
  hotPricingThresholdSec Int?
  inactivityDays         Int[]
  businessHourStart      Int?
  businessHourEnd        Int?

  sentAt         DateTime? // baseline for anti-ghosting
  lastActivityAt DateTime? // last tracked page view, used for reopen detection
  closedAt       DateTime?
  // Picked by the seller when the deal is lost, for the "what works" stats
  closedReason   DealCloseReason?
  closedNote     String?
  archivedAt     DateTime?

  // Deal context typed by the seller. sellerNotes is private: never sent to the message writer.
  dealAmountCents    Int?
  dealCurrency       String?
  decisionDeadline   DateTime?
  decisionMakerName  String?
  decisionMakerRole  String?
  sellerNotes        String?
  snoozedUntil       DateTime?
  // The customer agreed to be named as a reference in prospecting messages
  referenceConsentAt DateTime?

  brainDirtyAt DateTime? // something happened since the last deal analysis
  source       String? // where the link was created: null = dashboard, "extension_gmail", "extension_outlook", "outlook_addin"
  // Inserted in an email from the extension, not sent yet: hidden from the seller, archived after 7 days
  draftAt      DateTime?
  // The seller copied the draft's address: probably sent by hand, but not confirmed. Such a draft is
  // never archived, and counts as sent only once opened or once the seller says so
  copiedAt     DateTime?
  // Settings still come from the defaults: they follow the document type once the AI has read it
  autoSettings Boolean   @default(false)
  // One link for many readers (a deck posted or forwarded): each reader gives their email and
  // becomes a lead the seller can turn into a personal link. Never a deal of its own.
  shared       Boolean   @default(false)
  // Opened by the seller during the welcome tour to see the prospect side: never a deal, never counted
  isOnboardingTest Boolean @default(false)
  // A reader of a shared link gets their own link at the gate: a deal like any other
  parentLinkId String?
  parentLink   Link?     @relation("SharedReaders", fields: [parentLinkId], references: [id], onDelete: SetNull)
  readerLinks  Link[]    @relation("SharedReaders")

  prospects        Prospect[]
  views            DocumentView[]
  pageViews        PageView[]
  engagementScore  EngagementScore?
  followups        Followup[]
  alerts           SellerAlert[]
  actions          ProspectAction[]
  chatMessages     ChatMessage[]
  sellerActivities SellerActivity[]
  insights         DealInsight[]
  capsules         PageCapsule[]
  capsulePlays     CapsulePlay[]
  voiceComments    VoiceComment[]
  viewSignals      ViewSignal[]
  webhookEvents    WebhookEvent[]
  forwards         LinkForward[]

  // Created by a campaign for this enrollment
  campaignProspectId String?
  campaignProspect   CampaignProspect?
  // The campaign engine still owns this prospect: closing triggers keep off (lib/outreach/ownership.ts)
  campaignOwned      Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([documentId])
  @@index([dealStatus, followupsEnabled])
  @@index([expiresAt])
  @@index([parentLinkId])
  @@index([campaignProspectId])
  @@index([campaignOwned])
  @@map("links")
}

model Prospect {
  id     String @id @default(cuid())
  linkId String
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)

  email           String
  name            String?
  company         String?
  phoneE164       String?
  whatsappOptInAt DateTime? // WhatsApp requires explicit opt-in
  unsubscribedAt  DateTime?
  role            ProspectRole? // set by the seller, wins over the guess from the email
  origin          ProspectOrigin @default(SELLER)
  // An email Clozer sent bounced for good: nothing more goes to this address (SES notification)
  bouncedAt       DateTime?
  bounceDetail    String?
  // Marked one of our emails as spam: treated as an unsubscribe
  complainedAt    DateTime?

  // detected on first view (x-vercel-ip-timezone, accept-language), editable by seller
  locale      String?
  timezone    String?
  country     String?
  firstSeenAt DateTime?
  lastSeenAt  DateTime?

  // Who sent them the link with "Transférer" first: the edge of the seller's "Circuit du document".
  // Set once, never on a contact the seller added.
  forwardedById String?
  forwardedBy   Prospect?  @relation("ForwardTree", fields: [forwardedById], references: [id], onDelete: SetNull)
  forwardees    Prospect[] @relation("ForwardTree")

  views            DocumentView[]
  followups        Followup[]
  actions          ProspectAction[]
  voiceComments    VoiceComment[]
  forwardsSent     LinkForward[]    @relation("ForwardFrom")
  forwardsReceived LinkForward[]    @relation("ForwardTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([linkId, email])
  @@index([email])
  @@index([forwardedById])
  @@map("prospects")
}

// =============================================================================
// Analytics
// =============================================================================

// One reading session of a link
model DocumentView {
  id         String    @id @default(cuid())
  linkId     String
  link       Link      @relation(fields: [linkId], references: [id], onDelete: Cascade)
  documentId String
  prospectId String?
  prospect   Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  // Opened from the link in a follow-up (?f= in the URL): what brought the reader back
  followupId String?
  followup   Followup? @relation(fields: [followupId], references: [id], onDelete: SetNull)

  visitorId String // anonymous id kept in a first-party cookie
  email     String?
  ipHash    String? // salted hash, never the raw IP

  country   String?
  region    String?
  city      String?
  latitude  Float?
  longitude Float?
  timezone  String?
  locale    String?

  deviceType String? // desktop | mobile | tablet
  browser    String?
  os         String?
  referrer   String?
  userAgent  String?
  isBot      Boolean @default(false) // also true for the seller's own views (see fromSeller): excluded everywhere
  fromSeller Boolean @default(false) // opened by a member of the workspace that owns the link

  startedAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  totalDurationMs Int       @default(0)
  maxPageReached  Int       @default(1)
  currentPage     Int? // page on screen at the last flush, for the live indicator
  leftAt          DateTime? // tab hidden or closed; cleared by the next flush with reading time

  pageViews     PageView[]
  actions       ProspectAction[]
  chatMessages  ChatMessage[]
  capsulePlays  CapsulePlay[]
  voiceComments VoiceComment[]
  signals       ViewSignal[]

  @@index([linkId, lastSeenAt(sort: Desc)])
  @@index([linkId, visitorId])
  @@index([documentId])
  @@map("document_views")
}

model ViewSignal {
  id      String         @id @default(cuid())
  viewId  String
  view    DocumentView   @relation(fields: [viewId], references: [id], onDelete: Cascade)
  linkId  String
  link    Link           @relation(fields: [linkId], references: [id], onDelete: Cascade)
  type    ViewSignalType
  valueMs Int?
  detail  String? // TRANSLATED: the language read in

  createdAt DateTime @default(now())

  @@index([linkId, createdAt])
  @@index([viewId])
  @@map("view_signals")
}

// Time spent per page, aggregated per view (upserted on each tracking flush)
model PageView {
  id     String       @id @default(cuid())
  viewId String
  view   DocumentView @relation(fields: [viewId], references: [id], onDelete: Cascade)
  linkId String
  link   Link         @relation(fields: [linkId], references: [id], onDelete: Cascade)

  pageNumber      Int
  totalDurationMs Int      @default(0)
  hits            Int      @default(0) // tracking events received
  maxScrollDepth  Float? // 0..1, vertical scroll within the page
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  @@unique([viewId, pageNumber])
  @@index([linkId, pageNumber])
  @@index([linkId, lastSeenAt])
  @@map("page_views")
}

model EngagementScore {
  id     String @id @default(cuid())
  linkId String @unique
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)

  score           Int            @default(0) // 0-100
  tier            EngagementTier @default(COLD)
  uniqueViewers   Int            @default(0)
  visitCount      Int            @default(0)
  totalDurationMs Int            @default(0)
  reasons         Json? // [{ code, weight, detail }]
  computedAt      DateTime       @default(now())

  @@index([tier])
  @@map("engagement_scores")
}

// =============================================================================
// Follow-ups, alerts, prospect interactions
// =============================================================================

model Followup {
  id         String   @id @default(cuid())
  linkId     String
  link       Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  trigger FollowupTrigger
  channel FollowupChannel
  status  FollowupStatus  @default(PENDING)

  scheduledFor DateTime // UTC, computed from prospect timezone + business hours
  timezone     String
  locale       String   @default("en")
  context      Json? // behavioral snapshot used to build the prompt

  subject    String? // email only
  body       String?
  aiProvider String?
  aiModel    String?

  sentVia               FollowupSentVia?
  approvedAt            DateTime?
  approvedById          String?
  editedAt              DateTime?
  rationale             String? // why this follow-up, shown to the seller
  confidence            Int? // 0-100, AI decisions only
  insightId             String?
  regenerateInstruction String?

  triggerRunId      String?
  providerMessageId String? // SES message id or Twilio message SID
  error             String?
  dedupeKey         String    @unique // e.g. hot_pricing:<prospectId>:<yyyy-mm-dd>
  sentAt            DateTime?
  cancelledAt       DateTime?

  // What the message did, for the "what works" stats (SES notifications, ?f= in the link, reply relay)
  deliveredAt DateTime?
  bouncedAt   DateTime?
  clickedAt   DateTime? // first opening of the link from this message
  repliedAt   DateTime? // the prospect answered this message

  views DocumentView[]

  campaignProspectId String?
  campaignProspect   CampaignProspect? @relation(fields: [campaignProspectId], references: [id], onDelete: SetNull)
  campaignMessage    CampaignMessage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledFor])
  @@index([linkId, createdAt(sort: Desc)])
  @@index([prospectId])
  @@index([providerMessageId])
  @@index([campaignProspectId])
  @@map("followups_queue")
}

model SellerAlert {
  id     String @id @default(cuid())
  linkId String
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)

  type      SellerAlertType
  channels  SellerAlertChannel[]
  payload   Json
  dedupeKey String               @unique
  sentAt    DateTime?
  error     String?

  // Seller the alert is for (link creator, or the workspace owner)
  userId   String?
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  priority AlertPriority @default(INFO)
  // First time the seller opened the deal after the alert: how fast they react
  seenAt   DateTime?

  createdAt DateTime @default(now())

  @@index([linkId, createdAt(sort: Desc)])
  @@index([userId, createdAt])
  @@map("seller_alerts")
}

enum WebhookEventStatus {
  PENDING // waiting for its first send or a retry
  SENT
  FAILED // gave up after the last retry
}

// An engagement event for the workspace's outbound webhook (a cold email tool
// pausing its sequence): stored first, so a failed send is retried by the cron.
model WebhookEvent {
  id     String @id @default(cuid())
  linkId String
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)

  event         String
  dedupeKey     String             @unique
  payload       Json
  status        WebhookEventStatus @default(PENDING)
  attempts      Int                @default(0)
  lastError     String?
  nextAttemptAt DateTime           @default(now())
  sentAt        DateTime?

  createdAt DateTime @default(now())

  @@index([status, nextAttemptAt])
  @@map("webhook_events")
}

// What one seller wants to be told about, in one workspace. No row = defaults.
model NotificationPreference {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  emailActions         Boolean @default(true) // prospect validated or asked for a change
  emailCallMoments     Boolean @default(false) // "reading now" by email, when the extension is not running
  extensionCallMoments Boolean @default(true)
  morningDigest        Boolean @default(true)
  digestHour           Int     @default(8) // seller local hour
  timezone             String? // seller's, from the browser; null = DEFAULT_TIMEZONE

  lastDigestAt    DateTime?
  digestClaimedAt DateTime? // lock while a digest is being built and sent
  extensionSeenAt DateTime? // last extension poll: is it running?

  onboardingCompletedAt DateTime? // finished or skipped the welcome tour (/bienvenue)
  mailToolTipHiddenAt   DateTime? // "ne plus afficher" on the share screen tip about the extension / add-in
  mailClient            String? // gmail | outlook_web | outlook_desktop | other, picked during onboarding
  bookingUrl            String? // the seller's booking page (Calendly, Cal.com, HubSpot…), offered on their links
  onboardingStartedAt   DateTime? // first time on the welcome tour
  onboardingTestReadAt  DateTime? // the seller saw their own test link being read during the tour
  onboardingEmailsOff   Boolean   @default(false) // unsubscribed from the getting-started emails

  extensionNudgeHiddenAt DateTime? // closed the "install / connect the extension" banner: back after a week

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@map("notification_preferences")
}

// What happened outside Clozer, logged by the seller: calls, replies, meetings
model SellerActivity {
  id         String  @id @default(cuid())
  linkId     String
  link       Link    @relation(fields: [linkId], references: [id], onDelete: Cascade)
  prospectId String?
  userId     String?

  type       SellerActivityType
  note       String?
  occurredAt DateTime           @default(now())

  // A reply Clozer caught on its own: who wrote it, and a key so the same email is logged once
  source      ActivitySource @default(MANUAL)
  fromEmail   String?
  externalKey String?        @unique

  createdAt DateTime @default(now())

  @@index([linkId, occurredAt(sort: Desc)])
  @@map("seller_activities")
}

// The AI reading of a deal at one point in time. Append-only, last 20 kept per link.
// The engagement score stays the measured truth; this is the interpretation.
model DealInsight {
  id             String         @id @default(cuid())
  linkId         String
  link           Link           @relation(fields: [linkId], references: [id], onDelete: Cascade)
  organizationId String
  trigger        InsightTrigger
  inputHash      String // facts fingerprint: same facts, no new call

  stage             String // NOT_ENGAGED, DISCOVERING, EVALUATING…
  momentum          String // RISING, STEADY, COOLING
  confidence        Int // 0-100
  priority          Int // 1 (can wait) - 5 (act today)
  headline          String
  summary           String
  signals           Json // [{ label, factIds }]
  frictions         Json // [{ kind, detail, severity, factIds }]
  risks             Json // string[]
  recommendedAction Json // { type, channel, timing, recipient, prospectId, why, factIds }
  followupBrief     Json? // { goal, angle, topics, avoid }
  scoreNuance       String?
  factsSnapshot     Json // the facts the model saw, for audit and evals
  // "Préparer l'appel": talking points written on demand for the seller, kept with the reading they came from
  callScript        String?
  provider  String? // null: written by rules (deal never opened)
  model     String?
  tokensIn  Int     @default(0)
  tokensOut Int     @default(0)

  createdAt DateTime @default(now())

  @@index([linkId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt])
  @@map("deal_insights")
}

// One row per LLM call, for cost tracking and quotas
model AiUsage {
  id             String  @id @default(cuid())
  organizationId String
  linkId         String?

  purpose      String
  provider     String
  model        String
  tokensIn     Int     @default(0)
  tokensOut    Int     @default(0)
  cachedTokens Int     @default(0)
  costMicroUsd Int     @default(0)
  latencyMs    Int     @default(0)
  ok           Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("ai_usage")
}

model ProspectAction {
  id         String        @id @default(cuid())
  linkId     String
  link       Link          @relation(fields: [linkId], references: [id], onDelete: Cascade)
  viewId     String?
  view       DocumentView? @relation(fields: [viewId], references: [id], onDelete: SetNull)
  prospectId String?
  prospect   Prospect?     @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  type    ProspectActionType
  message String?

  // "Valider & signer": what the signer typed and agreed to, kept as evidence
  signerName     String?
  signerIpHash   String? // hashed like every IP we keep
  signerAgent    String?
  documentSha256 String? // the version they had in front of them

  createdAt DateTime @default(now())

  @@index([linkId, createdAt(sort: Desc)])
  @@map("prospect_actions")
}

// One "Transférer" from the viewer: who sent the link to whom, what they wrote (the seller sees it,
// the viewer says so), whether the email left and whether the recipient opened it.
model LinkForward {
  id             String    @id @default(cuid())
  linkId         String
  link           Link      @relation(fields: [linkId], references: [id], onDelete: Cascade)
  fromProspectId String?
  fromProspect   Prospect? @relation("ForwardFrom", fields: [fromProspectId], references: [id], onDelete: SetNull)
  toProspectId   String
  toProspect     Prospect  @relation("ForwardTo", fields: [toProspectId], references: [id], onDelete: Cascade)
  viewId         String? // the forwarder's reading session

  message      String?
  // The forwarder asked to be told when the recipient opens it
  notifyOnOpen Boolean @default(false)
  locale       String // the email's language: the forwarder's

  // quotas
  visitorId String
  ipHash    String?

  sentAt        DateTime? // the email provider accepted it
  error         String?
  openedAt      DateTime? // first real session of the recipient after this forward
  receiptSentAt DateTime? // claimed before sending: one receipt per forward

  createdAt DateTime @default(now())

  @@index([linkId, createdAt(sort: Desc)])
  @@index([toProspectId, openedAt])
  @@index([visitorId, createdAt])
  @@index([ipHash, createdAt])
  @@map("link_forwards")
}

model ChatMessage {
  id     String       @id @default(cuid())
  linkId String
  link   Link         @relation(fields: [linkId], references: [id], onDelete: Cascade)
  viewId String
  view   DocumentView @relation(fields: [viewId], references: [id], onDelete: Cascade)

  role      ChatRole
  content   String
  model     String?
  tokensIn  Int?
  tokensOut Int?
  escalated Boolean  @default(false) // USER row: the assistant forwarded the question to the seller
  flags     String[] @default([]) // ASSISTANT row: guard codes, the seller should check the answer

  createdAt DateTime @default(now())

  @@index([viewId, createdAt])
  @@index([linkId, createdAt])
  @@map("chat_messages")
}

// =============================================================================
// Help assistant: the users' own questions about Clozer, and what they send the team
// =============================================================================

model HelpMessage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  role      ChatRole
  content   String
  pathname  String? // USER row: the page the question was asked from
  model     String?
  tokensIn  Int?
  tokensOut Int?
  escalated Boolean  @default(false) // USER row: the assistant sent something to the team

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt])
  @@map("help_messages")
}

model HelpFeedback {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind      HelpFeedbackKind
  summary   String
  details   String?
  pathname  String?
  emailedAt DateTime? // null: no team inbox configured, or the email failed

  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@map("help_feedback")
}

// =============================================================================
// Page capsules and voice comments
// =============================================================================

enum CapsuleKind {
  VIDEO
  AUDIO
}

enum VoiceCommentStatus {
  PENDING
  TRANSCRIBED
  FAILED
}

// A short clip the seller recorded for one page. linkId null = shown on every
// link of the document, otherwise it replaces that default for one link.
model PageCapsule {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  linkId     String?
  link       Link?    @relation(fields: [linkId], references: [id], onDelete: Cascade)
  // "doc" or the link id: Postgres treats NULLs as distinct, a unique on linkId would allow two defaults
  scopeKey   String

  pageNumber     Int // 0 = welcome message, else 1-based page
  kind           CapsuleKind
  blobPathname   String
  contentType    String // without codecs
  // First frame of a video, so the bubble shows a still instead of downloading the clip
  posterPathname String?
  sizeBytes      Int
  durationMs     Int
  hookText       String? // "Sur cette partie, laisse-moi t'expliquer…"
  createdById    String?

  plays CapsulePlay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentId, pageNumber, scopeKey])
  @@index([linkId])
  @@map("page_capsules")
}

// The prospect opened a capsule. One row per capsule and reading session.
model CapsulePlay {
  id        String       @id @default(cuid())
  capsuleId String
  capsule   PageCapsule  @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  linkId    String
  link      Link         @relation(fields: [linkId], references: [id], onDelete: Cascade)
  viewId    String
  view      DocumentView @relation(fields: [viewId], references: [id], onDelete: Cascade)

  pageNumber Int

  createdAt DateTime @default(now())

  @@unique([capsuleId, viewId])
  @@index([linkId, createdAt(sort: Desc)])
  @@map("capsule_plays")
}

model VoiceComment {
  id         String       @id @default(cuid())
  linkId     String
  link       Link         @relation(fields: [linkId], references: [id], onDelete: Cascade)
  viewId     String
  view       DocumentView @relation(fields: [viewId], references: [id], onDelete: Cascade)
  prospectId String?
  prospect   Prospect?    @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  pageNumber   Int
  blobPathname String
  contentType  String
  sizeBytes    Int
  durationMs   Int // measured by the browser, replaced by the transcription's when known
  status       VoiceCommentStatus @default(PENDING)
  transcript   String?
  language     String?

  createdAt DateTime @default(now())

  @@index([linkId, createdAt(sort: Desc)])
  @@index([viewId, createdAt])
  @@map("voice_comments")
}

// =============================================================================
// Prospecting (POC behind PROSPECTING_ORG_IDS): B2B contacts that look like the seller's target
// =============================================================================

enum TargetOrigin {
  MANUAL
  INFERRED // deduced from the seller's sent quotes and presentations, then checked by the seller
}

enum ProspectingProvider {
  APOLLO
  LEMLIST
  MOCK // local tests only
}

enum ProspectingRunStatus {
  RUNNING
  DONE
  FAILED
}

enum SuggestionStatus {
  SUGGESTED // masked, waiting for the seller
  ACCEPTED // accepted, reveal not started yet
  REVEALING // reveal asked to the provider (async for Lemlist)
  READY // verified professional email
  INVALID // see invalidReason: never billed
  REJECTED // the seller said no: never suggested again in this workspace
}

enum SuggestionInvalidReason {
  NOT_FOUND
  UNVERIFIED
  PERSONAL // personal mailbox: dropped, never stored
  DUPLICATE // already a prospect of the workspace
  OPTED_OUT
}

enum OptOutKind {
  EMAIL
  LINKEDIN
  PROVIDER_ID
  PERSON // first name + last initial + company: the same person seen through another provider
}

enum CreditEntryKind {
  SEARCH
  REVEAL // provider credits actually spent
  DELIVERED // one READY contact: the future billing unit
}

model TargetProfile {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  origin         TargetOrigin @default(MANUAL)
  active         Boolean      @default(true)

  nafCodes         String[] // NAF rev. 2 sub-classes, "62.01Z"
  keywords         String[] // free words sent to the provider search
  headcountCodes   String[] // INSEE tranches, "11", "12"
  regions          String[] // INSEE region codes, "84"
  departements     String[]
  jobTitles        String[]
  seniorities      String[] // owner, founder, c_suite, director…
  excludedDomains  String[]
  inferredEvidence Json? // what the deduction was based on, shown to the seller

  runs ProspectingRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, active])
  @@map("target_profiles")
}

model ProspectingRun {
  id              String               @id @default(cuid())
  organizationId  String
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targetProfileId String
  targetProfile   TargetProfile        @relation(fields: [targetProfileId], references: [id], onDelete: Cascade)
  provider        ProspectingProvider
  status          ProspectingRunStatus @default(RUNNING)
  comparisonId    String? // two runs started together on the same target
  filtersSnapshot Json
  found           Int                  @default(0)
  skipped         Int                  @default(0) // duplicates, opt-outs, off-target companies
  created         Int                  @default(0)
  error           String? // why it failed, or why a done run stopped early
  startedAt       DateTime             @default(now())
  finishedAt      DateTime?

  suggestions ProspectSuggestion[]

  @@index([organizationId, startedAt(sort: Desc)])
  @@index([comparisonId])
  @@map("prospecting_runs")
}

model ProspectSuggestion {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runId           String
  run             ProspectingRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  provider        ProspectingProvider
  externalId      String
  sourceFetchedAt DateTime // when the provider gave us this person

  // Masked until revealed: what the seller decides on
  firstName      String?
  lastNameMasked String?
  title          String?
  seniority      String?
  companyName    String?
  companyDomain  String?
  companySiren   String?
  nafVerified    Boolean? // registry: true = target sector, false = another NAF code, null = unknown
  linkedinUrl    String? // only as given by the provider, never scraped
  dedupeKey      String // sha256 of the person key: all that stays once the personal fields are purged

  status        SuggestionStatus         @default(SUGGESTED)
  invalidReason SuggestionInvalidReason?
  decidedAt     DateTime?
  decidedById   String?

  // Reveal
  lastName        String?
  email           String?
  emailStatus     String?
  revealJobId     String?
  revealAttempts  Int       @default(0)
  revealStartedAt DateTime?
  revealedAt      DateTime?

  linkId      String?
  hookSubject String?
  hookBody    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, provider, externalId])
  @@index([runId])
  @@index([organizationId, status])
  @@index([organizationId, dedupeKey])
  @@index([status, revealStartedAt])
  @@map("prospect_suggestions")
}

// Global, across workspaces: someone who said no is never suggested to anyone again.
// Only a hash of the normalized value is kept.
model ProspectingOptOut {
  id        String     @id @default(cuid())
  kind      OptOutKind
  valueHash String
  reason    String // "seller", "unsubscribe"
  createdAt DateTime   @default(now())

  @@unique([kind, valueHash])
  @@map("prospecting_opt_outs")
}

// Append-only: provider credits spent and contacts delivered, per workspace
model ProspectingCreditEntry {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       ProspectingProvider
  kind           CreditEntryKind
  credits        Int                 @default(0)
  estimated      Boolean             @default(false) // computed from the provider price list, not reported by it
  suggestionId   String?
  createdAt      DateTime            @default(now())

  @@index([organizationId, createdAt])
  @@index([suggestionId])
  @@map("prospecting_credit_entries")
}

// Cache of the public company registry (recherche-entreprises.api.gouv.fr), shared by all workspaces
model CompanyLookup {
  key           String   @id // "domain:acme.fr" or "name:acme|69"
  siren         String?
  name          String?
  naf           String?
  headcountCode String?
  departement   String?
  region        String?
  confidence    Float    @default(0)
  fetchedAt     DateTime @default(now())

  @@map("company_lookups")
}

// Getting-started emails already sent to a seller, one row per kind (welcome, no_document…)
model OnboardingEmail {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           String
  sentAt         DateTime     @default(now())

  @@unique([userId, organizationId, kind])
  @@map("onboarding_emails")
}

// Stripe webhook events already handled: Stripe delivers at least once
model StripeEvent {
  id             String        @id // evt_…
  type           String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  receivedAt     DateTime      @default(now())

  @@index([organizationId, receivedAt])
  @@map("stripe_events")
}

// ============================================================================
// Outreach (native cold email)
// ============================================================================

enum MailboxProvider {
  GOOGLE
  MICROSOFT
  IMAP
}
// How Clozer talks to the mailbox: Google through an intermediary (pinned at connect time), Microsoft through Graph, anything else by IMAP/SMTP
enum MailboxConnector {
  UNIPILE
  NYLAS
  GRAPH
  SMTP
}
enum MailboxStatus {
  CONNECTING
  ACTIVE
  ERROR
  DISCONNECTED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  DONE
  ARCHIVED
}
enum EnrollmentStatus {
  QUEUED
  ACTIVE
  PAUSED
  REPLIED
  BOUNCED
  UNSUBSCRIBED
  SUPPRESSED
  FINISHED
  STOPPED
}
enum CampaignMessageKind {
  STEP
  FOLLOWUP
}
enum CampaignMessageStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
  SKIPPED
}
enum SuppressionReason {
  UNSUBSCRIBE
  BOUNCE
  COMPLAINT
  MANUAL
}
enum MailboxInboundKind {
  REPLY
  BOUNCE
  IGNORED
}

// A seller's own mailbox, connected to send campaigns from. Belongs to the member who connected it.
model Mailbox {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider    MailboxProvider
  connector   MailboxConnector
  email       String // lowercase
  domain      String // part after the @, for DNS checks
  displayName String?
  signature   String? // null: WorkspaceSettings.senderSignature
  // encryptSecret(JSON): IMAP/SMTP hosts + user + password, Graph refresh token, or the intermediary's account id
  credentials       String
  externalAccountId String?

  status          MailboxStatus @default(CONNECTING)
  lastError       String?
  lastErrorAt     DateTime?
  errorNotifiedAt DateTime? // one email per error episode

  dailyCap      Int      @default(30)
  rampStartedAt DateTime @default(now()) // a fresh mailbox sends a few a day at first
  timezone      String // the seller's at connect time: what "today" means for the cap
  sentDay       String? // yyyy-mm-dd in `timezone`
  sentCount     Int      @default(0)
  policyBounceDay   String?
  policyBounceCount Int  @default(0)

  spfOk        Boolean?
  dkimOk       Boolean?
  dmarcOk      Boolean?
  dkimSelector String?
  dnsDetail    Json?
  dnsCheckedAt DateTime?

  // Reply and bounce sync: provider cursor (IMAP "uidValidity:uid", Graph deltaLink, intermediary date), lease, backoff
  syncCursor      String?
  lastSyncAt      DateTime?
  nextSyncAt      DateTime?
  syncRequestedAt DateTime? // a webhook asked for a sync
  syncClaimedAt   DateTime?
  syncErrorCount  Int       @default(0)
  // Change notifications (Graph, intermediaries)
  subscriptionId        String?
  subscriptionExpiresAt DateTime?
  webhookSecret         String? // encrypted at rest

  disconnectedAt DateTime?
  campaigns      Campaign[]
  messages       CampaignMessage[]
  inboundEvents  MailboxInboundEvent[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, email])
  @@index([status, nextSyncAt])
  @@index([userId])
  @@map("mailboxes")
}

// A pending OAuth handshake (Microsoft, Gmail intermediary): PKCE verifier and where to go back
model MailboxOauthState {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  provider       MailboxProvider
  codeVerifier   String?
  redirectTo     String?
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([expiresAt])
  @@map("mailbox_oauth_states")
}

// What the sync saw in the seller's inbox: ids and a short excerpt only, never a body
model MailboxInboundEvent {
  id          String            @id @default(cuid())
  mailboxId   String
  mailbox     Mailbox           @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  externalKey String            @unique // mailbox:<mailboxId>:<provider message id>
  kind        MailboxInboundKind
  messageId   String?
  inReplyTo   String?
  fromEmail   String?
  subject     String?
  receivedAt  DateTime
  excerpt     String? // 600 characters max
  dsnStatus   String?
  dsnClass    String?
  matchedMessageId String?
  enrollmentId     String?
  createdAt   DateTime @default(now())

  @@index([mailboxId, receivedAt(sort: Desc)])
  @@map("mailbox_inbound_events")
}

model Campaign {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  // SetNull: deleting a user cascades to their mailbox; the campaign and its history stay, but it cannot send until re-assigned
  mailboxId      String?
  mailbox        Mailbox?     @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  // The document the Clozer link opens; required to activate when a step carries the link
  documentId     String?
  document       Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)

  name        String
  status      CampaignStatus @default(DRAFT)
  locale      String // language of the steps and of the AI follow-ups
  linkOnReply Boolean        @default(false) // no step carries the link: it goes out with the seller's answer

  steps       CampaignStep[]
  enrollments CampaignProspect[]
  messages    CampaignMessage[]
  startedAt   DateTime?
  pausedAt    DateTime?
  finishedAt  DateTime?
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId, status])
  @@map("campaigns")
}

model CampaignStep {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  order       Int // 1-based
  delayDays   Int      @default(3) // after the previous step was sent; 0 for the first
  subject     String? // null past step 1: same thread, "Re: <thread subject>"
  newThread   Boolean  @default(false)
  body        String // text with {{firstName|there}}, {{company}}, {{link}}
  carriesLink Boolean  @default(false) // at most one step per campaign (checked in code)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([campaignId, order])
  @@map("campaign_steps")
}

// One person enrolled in a campaign. Nothing on the dashboard until the link exists.
model CampaignProspect {
  id             String   @id @default(cuid())
  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organizationId String // denormalized: suppression and "already enrolled" checks

  email     String // lowercase
  firstName String?
  lastName  String?
  company   String?
  title     String?
  vars      Json? // extra CSV columns, usable as {{var}}
  timezone  String // from the CSV, else the seller's; Prospect.timezone takes over once they read
  locale    String

  status       EnrollmentStatus @default(QUEUED)
  currentStep  Int              @default(0) // last step order sent
  nextSendAt   DateTime?
  pausedReason String?
  pausedAt     DateTime?
  repliedAt    DateTime?
  finishedAt   DateTime?

  // Threading: our RFC Message-ID of the first mail, the provider thread id, the subject the thread started with
  threadSubject    String?
  firstMessageId   String?
  providerThreadId String?

  // Set lazily when the link step is sent, or on reply
  linkId     String? @unique
  link       Link?   @relation(fields: [linkId], references: [id], onDelete: SetNull)
  prospectId String?

  readEvaluatedAt DateTime?
  lastSignal      String?
  reactivatedAt   DateTime?

  messages  CampaignMessage[]
  followups Followup[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, email])
  @@index([status, nextSendAt])
  @@index([organizationId, email])
  @@index([campaignId, status])
  @@map("campaign_prospects")
}

// One email that left (or will leave) the seller's mailbox for an enrollment: fixed steps are born here,
// AI follow-ups are Followup rows mirrored here when they go out
model CampaignMessage {
  id           String           @id @default(cuid())
  campaignId   String
  campaign     Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   CampaignProspect @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  mailboxId    String
  mailbox      Mailbox          @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  stepId       String?
  followupId   String?          @unique
  followup     Followup?        @relation(fields: [followupId], references: [id], onDelete: SetNull)
  kind         CampaignMessageKind @default(STEP)

  status       CampaignMessageStatus @default(SCHEDULED)
  scheduledFor DateTime
  sendingAt    DateTime? // lease
  attempts     Int       @default(0)
  sentAt       DateTime?
  error        String?

  subject           String
  body              String // rendered text, as sent
  messageId         String? // RFC 5322 Message-ID: ours for SMTP and intermediaries, Exchange's read back after send
  providerMessageId String?
  inReplyTo         String?
  threadId          String?
  carriesLink       Boolean @default(false)

  dedupeKey    String    @unique // cold:<enrollmentId>:<stepId> | cold:<enrollmentId>:fu:<followupId>
  bouncedAt    DateTime?
  bounceDetail String?
  repliedAt    DateTime?
  clickedAt    DateTime? // first opening of the link carried by this message

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledFor])
  @@index([mailboxId, status, sentAt])
  @@index([enrollmentId, createdAt(sort: Desc)])
  @@index([messageId])
  @@map("campaign_messages")
}

// Workspace-level stop list, plain lowercase email: the workspace already holds the address
// (prospecting_opt_outs stays global and hashed)
model Suppression {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  reason         SuppressionReason
  source         String // "unsubscribe_page" | "mailbox_sync" | "ses" | "seller" | "import"
  detail         String?
  createdAt      DateTime          @default(now())

  @@unique([organizationId, email])
  @@map("suppressions")
}
