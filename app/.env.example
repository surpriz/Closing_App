# Copy to .env.local for local development. Production values live in Vercel.

# [[APP]]
# Public URL of the app (links in emails, background jobs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [[DATABASE - NEON]]
# Pooled connection (host contains "-pooler"), used by the app at runtime
DATABASE_URL=
# Direct connection, used by Prisma CLI for migrations
DATABASE_URL_UNPOOLED=

# [[AUTH - BETTER AUTH]]
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [[STORAGE - VERCEL BLOB]]
BLOB_READ_WRITE_TOKEN=
# Set on Vercel only: it switches @vercel/blob to OIDC auth, which is off for local development
# BLOB_STORE_ID=

# [[EMAIL - AMAZON SES]]
# Leave empty locally: sign-in links are then shown on the login page instead of emailed.
# AWS_* names are reserved on Vercel, hence the SES_* prefix.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Optional SES configuration set (event publishing, dedicated IPs)
SES_CONFIGURATION_SET=
# Senders must belong to the verified SES domain
AUTH_EMAIL_FROM="Clozer <connexion@clozer.club>"
FOLLOWUP_EMAIL_FROM="Clozer <relances@clozer.club>"
# Fallback reply-to when the link creator has no email
FOLLOWUP_EMAIL_REPLY_TO=

# [[AI]]
# openai | anthropic
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides, e.g. gpt-4o / claude-sonnet-5
AI_MODEL_FOLLOWUP=
AI_MODEL_CHAT=
# Cheap model for page tagging, e.g. gpt-4o-mini / claude-haiku-5-5
AI_MODEL_CLASSIFY=
# Prospect voice comments, always OpenAI (needs OPENAI_API_KEY), e.g. gpt-4o-mini-transcribe / whisper-1
AI_MODEL_TRANSCRIBE=
# Video pitches, cut into tenths by timestamps: a model that returns them (whisper-1)
AI_MODEL_TRANSCRIBE_TIMED=
# Prospect assistant, per workspace: questions per day and USD per day
AI_CHAT_DAILY_LIMIT=300
AI_CHAT_DAILY_BUDGET_USD=10
# Help assistant for logged-in users: model override, USD per day across all workspaces,
# and the team inbox that receives their suggestions and bug reports (unset: stored in help_feedback only)
AI_MODEL_HELP=
AI_HELP_DAILY_BUDGET_USD=5
HELP_INBOX_EMAIL=contact@clozer.club
# Documents translated in the viewer. Web pages: by the AI (model override, cheap one, e.g. gpt-4o-mini /
# claude-haiku-5-5). PDFs: by DeepL with their layout (Free keys end in ":fx"). DeepL bills at least
# 50,000 characters per PDF. Translations are kept: each document is paid once per language
AI_MODEL_TRANSLATE=
DEEPL_API_KEY=
DEEPL_PRICE_PER_MILLION_USD=25
AI_TRANSLATE_DAILY_BUDGET_USD=20

# [[WHATSAPP - TWILIO]]
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender in Twilio format, e.g. whatsapp:+33612345678
TWILIO_WHATSAPP_FROM=
# Approved content template, required outside the 24h customer service window
TWILIO_WHATSAPP_TEMPLATE_SID_FOLLOWUP=

# [[BACKGROUND ENGINE]]
# openssl rand -hex 32. Protects /api/cron/closing, called every 5 minutes by
# .github/workflows/closing-tick.yml (GitHub secrets APP_URL + CRON_SECRET) and
# once a day by the Vercel cron in vercel.json.
CRON_SECRET=
# Optional alternative scheduler (src/trigger/closing-tick.ts)
TRIGGER_PROJECT_ID=
TRIGGER_SECRET_KEY=

# [[BROWSER EXTENSION]]
# IDs of the Chrome extension builds allowed to receive a token from
# /extension/connect, comma-separated (Web Store ID in production, the fixed
# dev/staging ID from extension/wxt.config.ts elsewhere).
EXTENSION_IDS=
# Kill switch: extensions older than this stop and ask for an update
EXTENSION_MIN_VERSION=
# Hosts to switch off, comma-separated: gmail, outlook (Outlook web in Chrome), outlook-addin
EXTENSION_DISABLED_HOSTS=
# Kill switch for the extension's "reading now" notifications and badge
EXTENSION_NOTIFICATIONS_DISABLED=
# Chrome Web Store page, shown in the welcome tour (/bienvenue). Empty = "coming soon"
EXTENSION_STORE_URL=

# [[SECURITY]]
# 32+ chars, encrypts Slack webhook URLs and webhook secrets at rest
ENCRYPTION_KEY=
# 16+ chars, salts viewer IP hashes (raw IPs are never stored)
IP_HASH_SALT=

# [[FOLLOW-UPS]]
# Used when the prospect timezone could not be detected
DEFAULT_TIMEZONE=Europe/Paris

# [[PLATFORM ADMIN]]
# The only account allowed in /admin (users, workspaces, bans, sign-ups)
PLATFORM_ADMIN_EMAIL=

# [[BILLING - STRIPE]] (not used yet)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
