{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["office-js", "vite/client"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": { "@ext/*": ["../extension/src/lib/*"], "@extui/*": ["../extension/src/ui/*"] }
  },
  "include": ["src", "vite.config.ts", "vite.commands.config.ts", "vitest.config.ts", "manifest.ts"]
}
